# ===== BACKEND =====
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/nova_english

# JWT
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_REFRESH_EXPIRES_IN=7d

# Admin JWT (shorter lived)
ADMIN_JWT_SECRET=your-admin-jwt-secret
ADMIN_JWT_EXPIRES_IN=8h

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# File storage (local dev)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Cloudinary (for production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment card info (shown to students)
PAYMENT_CARD_NUMBER=8600 0000 0000 0000
PAYMENT_CARD_HOLDER=Nova English

# ===== STUDENT APP =====
VITE_API_URL=http://localhost:3001/api/v1

# ===== ADMIN PANEL =====
VITE_ADMIN_API_URL=http://localhost:3001/api/v1
