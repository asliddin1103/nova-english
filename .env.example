# ===== BACKEND =====
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/nova_english

# JWT
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-here-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Admin JWT (shorter lived)
ADMIN_JWT_SECRET=your-admin-jwt-secret-min-32-chars
ADMIN_JWT_EXPIRES_IN=8h

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# CORS — comma-separated list of allowed frontend origins (no spaces)
# Add Vercel URLs here after deployment, e.g.:
#   ALLOWED_ORIGINS=https://nova-english.vercel.app,https://nova-english-admin.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# File storage (local dev)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Cloudinary (for production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment card info (shown to students)
PAYMENT_CARD_NUMBER=8600 0000 0000 0000
PAYMENT_CARD_HOLDER=Nova English

# ===== STUDENT APP (Vite) =====
# Local dev — proxy in vite.config.ts handles /api → localhost:3001
# Production — set to your Railway backend URL
VITE_API_URL=https://your-backend.up.railway.app/api/v1

# ===== ADMIN PANEL (Vite) =====
# Local dev — proxy in vite.config.ts handles /api → localhost:3001
# Production — set to your Railway backend URL
VITE_ADMIN_API_URL=https://your-backend.up.railway.app/api/v1
